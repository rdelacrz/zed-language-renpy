{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "renpy",
      "camelcase": "Renpy",
      "title": "Ren'Py",
      "scope": "source.renpy",
      "file-types": [
        "rpy",
        "rpym"
      ],
      "injection-regex": "^renpy$",
      "class-name": "TreeSitterRenpy"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Ren'Py",
    "authors": [
      {
        "name": "M. A. Azzam",
        "url": "https://github.com/ZeynTheDev"
      },
      {
        "name": "Oleksandr",
        "url": "https://github.com/rockettap"
      }
    ],
    "links": {
      "repository": "https://github.com/rockettap/renpy-tree-sitter"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
