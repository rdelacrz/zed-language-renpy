{
  "grammars": [
    {
      "name": "renpy",
      "camelcase": "Renpy",
      "scope": "source.renpy",
      "path": ".",
      "file-types": [
        "rpy",
        "rpym"
      ],
      "injection-regex": "renpy"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Ren'Py",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-renpy"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
